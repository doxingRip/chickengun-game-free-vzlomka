{
  "name": "chickengun-prank",
  "version": "1.1.0",
  "description": "A harmless full-screen photo and music prank",
  "main": "src/main.js",
  "author": "NullPoint",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nullpoint.chickengunprank",
    "productName": "ChickenGun Prank",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "*.jpg",
      "*.jpeg",
      "*.png",
      "*.webp",
      "*.mp3",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ChickenGun-Prank-Portable-${version}.${ext}"
    }
  }
}
